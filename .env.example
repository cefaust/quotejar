POSTGRES_USER=quotejar
POSTGRES_PASSWORD=changeme
POSTGRES_DB=quotejar
DATABASE_URL=postgresql+psycopg://quotejar:changeme@localhost:5432/quotejar
TEST_DATABASE_URL=postgresql+psycopg://quotejar:changeme@localhost:5432/quotejar_test

# Signs and verifies access tokens. The value below is a throwaway for local
# development only -- it is committed to a public repository, so treat any
# token signed with it as public knowledge.
#
# Anyone who knows this secret can forge a token for any user. Generate your
# own before this runs anywhere real:
#
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# secrets.token_urlsafe draws from the OS cryptographic random source, which
# is the point -- a secret guessable by brute force is not a secret. Avoid
# random.random() here; it is a Mersenne Twister seeded predictably and its
# entire future output can be reconstructed from a few observed values.
JWT_SECRET=dev-only-not-for-production-Aq3nT8xKp2mWvZ7bY4cR9sL6hJ5gF1dN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
